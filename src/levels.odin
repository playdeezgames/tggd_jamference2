package main

// Map rows are listed top to bottom (the first row is y = BOARD_H-1).
//   #  wall (solid for cat and vacuum)
//   .  floor
//   C  cat start
//   V  vacuum start (must lie on its route)
//   S  sofa nap spot, B  basket nap spot, K  keyboard nap spot
//      A spot needs a wall beside it: bumping a wall is the only way to stay put and nap.
Level :: struct {
	map_rows: [BOARD_H]string,
	// Corners of the vacuum's closed loop, hidden from the player. Each leg is straight.
	// The last waypoint must equal the first. A leg may retrace an earlier one.
	route:    []Tile,
	// Tileset tiles for this level's look (see Urizen tileset coordinates).
	wall:     Tile,
	floor:    Tile,
	// The brown laundry basket is hard to see on some floors; draw it brighter there.
	bright_baskets: bool,
}

Tile :: [2]int

